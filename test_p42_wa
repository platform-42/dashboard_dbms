import sys
import time
import random

from ops_stats import OpsClient

client = OpsClient(flush_interval_s=30) 

#
#   catch all exceptions before exit - mark object as down in the dashboard
#
def handle_uncaught_exception(exc_type, exc_value, exc_traceback):
    if issubclass(exc_type, KeyboardInterrupt):
        sys.__excepthook__(exc_type, exc_value, exc_traceback)
        return
    client.update_state("InnovativeAISolutions", "CHANNEL", "WhatsApp", False)
    client.close()

sys.excepthook = handle_uncaught_exception

if __name__ == "__main__":
    client.update_state("InnovativeAISolutions", "CHANNEL", "WhatsApp", True)
    while True:
        time.sleep(random.randint(1, 3))
        errors = 1 if random.random() < 0.20 else 0
        client.update_stats("InnovativeAISolutions", "CHANNEL", "WhatsApp", 1, errors, random.randint(10, 100))
