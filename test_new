import sys
import time
import random

from ops_stats import OpsClient

client = OpsClient(flush_interval_s=30) 

#
#   catch all exceptions before exit - mark object as down in the dashboard
#
def handle_uncaught_exception(exc_type, exc_value, exc_traceback):
    if issubclass(exc_type, KeyboardInterrupt):
        sys.__excepthook__(exc_type, exc_value, exc_traceback)
        return
    client.update_state("Platform42", "ORCHESTRATOR", "Platform42", False)
    client.close()

sys.excepthook = handle_uncaught_exception

if __name__ == "__main__":
    # update states
    client.update_state("Platform42", "ORCHESTRATOR", "Platform42", True)
    client.update_state("Platform42", "CHANNEL", "WhatsApp", True)
    client.update_state("Platform42", "CHANNEL", "Instagram", True)
    while True:
        # bump first round of stats
        time.sleep(random.randint(1, 5))
        errors_10 = 1 if random.random() < 0.10 else 0
        errors_20 = 1 if random.random() < 0.20 else 0
        client.update_stats("Platform42", "CHANNEL", "WhatsApp", 1, errors_10, 180.0)
        client.update_stats("Platform42", "CHANNEL", "Instagram", 1, errors_20, 55.0)
