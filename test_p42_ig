import sys
import time
import random

from ops_stats import OpsClient

client = OpsClient(flush_interval_s=30) 

#
#   catch all exceptions before exit - mark object as down in the dashboard
#
def handle_uncaught_exception(exc_type, exc_value, exc_traceback):
    if issubclass(exc_type, KeyboardInterrupt):
        sys.__excepthook__(exc_type, exc_value, exc_traceback)
        return
    client.update_state("Platform42", "CHANNEL", "Instagram", False)
    client.close()

sys.excepthook = handle_uncaught_exception

if __name__ == "__main__":
    client.update_state("Platform42", "CHANNEL", "Instagram", True)
    while True:
        # bump first round of stats
        time.sleep(random.randint(1, 5))
        errors = 1 if random.random() < 0.10 else 0
        client.update_stats("Platform42", "CHANNEL", "Instagram", 1, errors, 55.0)
        a = 10 / random.randint(0, 40)
